<script is:inline>
  (function () {
    function init() {
      var modal = document.getElementById('fdp-modal');
      var raw = document.getElementById('fdp-data');
      if (!modal || !raw || modal.dataset.ready) return;
      modal.dataset.ready = '1';
      var D = JSON.parse(raw.textContent || '{}');
      var fmt = function (n) { return '$' + Number(n).toLocaleString('es-AR'); };

      function precioPorLook(pack, looks) {
        if (pack && pack.tramos && pack.tramos.length) {
          for (var t = 0; t < pack.tramos.length; t++) {
            if (pack.tramos[t].hasta == null || looks <= pack.tramos[t].hasta) return pack.tramos[t].precio;
          }
          return pack.tramos[pack.tramos.length - 1].precio;
        }
        return pack && pack.precio ? pack.precio : null;
      }

      function actualizar(form) {
        var j = D.jornadas[form.getAttribute('data-form')];
        var packsList = (j.packs && j.packs.length) ? j.packs : D.packs;
        var sel = form.querySelector('input[type=radio]:checked');
        var pack = packsList[sel ? Number(sel.value) : 0] || {};
        var looks = Number(form.querySelector('[data-looks]').textContent) || 1;
        var marca = (form.querySelector('[data-marca]').value || '').trim();
        var reelEl = form.querySelector('[data-reel]');
        var quiereReel = !!(reelEl && reelEl.checked);
        var ex = D.extra || {};
        var porLook = precioPorLook(pack, looks);
        var base = porLook ? porLook * looks : null;
        var total = base === null ? 'A confirmar' : (quiereReel && ex.precio ? fmt(base + ex.precio) : fmt(base) + (quiereReel ? ' + reel' : ''));
        form.querySelector('[data-total]').textContent = total;
        var msg = '¡Hola Ciava! Quiero reservar mi lugar en el Flash Day 📸\n\n' +
          '📅 Fecha: ' + j.texto + (j.horario ? ' (' + j.horario + ')' : '') + '\n' +
          '👤 Modelo: ' + j.modelo + '\n' +
          '📦 Pack: ' + (pack.nombre || '') + '\n' +
          '👗 Looks: ' + looks + '\n' +
          (D.extra ? '🎬 Reel editado: ' + (quiereReel ? 'Sí, quiero sumarlo' : 'No') + '\n' : '') +
          '💰 Total estimado: ' + total + '\n' +
          '🏷️ Marca: ' + (marca || '(completar)');
          
        form.querySelector('[data-reservar]').href = 'https://wa.me/' + D.numero + '?text=' + encodeURIComponent(msg);
      }

      modal.querySelectorAll('[data-form]').forEach(function (form) {
        form.addEventListener('change', function () { actualizar(form); });
        form.addEventListener('input', function () { actualizar(form); });
        form.querySelectorAll('[data-step]').forEach(function (b) {
          b.addEventListener('click', function () {
            var out = form.querySelector('[data-looks]');
            var n = Math.max(1, Math.min(99, (Number(out.textContent) || 1) + Number(b.getAttribute('data-step'))));
            out.textContent = String(n);
            actualizar(form);
          });
        });
        actualizar(form);
      });

      function abrir(i) {
        modal.querySelectorAll('.fdp-detail').forEach(function (d) { d.hidden = d.getAttribute('data-j') !== String(i); });
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        var card = modal.querySelector('.fdp-modal-card'); if (card) card.scrollTop = 0;
      }
      function cerrar() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
      document.querySelectorAll('[data-open]').forEach(function (c) {
        c.addEventListener('click', function () { abrir(c.getAttribute('data-open')); });
        c.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); abrir(c.getAttribute('data-open')); } });
      });
      modal.querySelectorAll('[data-close]').forEach(function (b) { b.addEventListener('click', cerrar); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && modal.classList.contains('is-open')) cerrar(); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
