---
/**
 * Página Flash Day (/flash-day)
 * - Los datos (packs y próximas jornadas) están en src/data/flashdays.json
 * - Las fechas que ya pasaron se ocultan solas (en la próxima publicación).
 * - Estados de una jornada: "disponible", "ultimos" o "completo".
 * - La foto de la portada sale de src/assets/images/flashday/ (la misma del pop-up).
 */
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { resolveImageWarn } from '../lib/images';
import data from '../data/flashdays.json';
import settings from '../data/settings.json';

const numero = (settings.contact.whatsapp || '').replace(/[^\d]/g, '');
const waLink = (msg: string) => `https://wa.me/${numero}?text=${encodeURIComponent(msg)}`;
const linkPersonalizado = waLink('¡Hola Ciava! Quiero algo personalizado para mi marca, ¿me cotizan? 😊');
const linkAvisame = waLink('¡Hola Ciava! Quiero que me avisen cuando haya nuevas fechas de Flash Day 📸');

const portadas = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/flashday/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);
const portada = Object.values(portadas)[0]?.default ?? null;

const MESES = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'];
const DIAS = ['DOM', 'LUN', 'MAR', 'MIÉ', 'JUE', 'VIE', 'SÁB'];
const hoy = new Date();
hoy.setHours(0, 0, 0, 0);

type Pack = { nombre: string; precio: number | null; unidad?: string; descripcion?: string };
const packs: Pack[] = data.packs as Pack[];
const precio = (n: number | null) => (n ? '$' + n.toLocaleString('es-AR') : 'Consultar');
type Extra = { nombre: string; precio: number | null; descripcion?: string };
const extra: Extra | null = ((data as any).extra as Extra) ?? null;
const desdePrecio = packs.map((p) => p.precio).filter((n): n is number => !!n).sort((a, b) => a - b)[0] ?? null;
const packsDe = (j: any) => (j.packs && j.packs.length ? j.packs : packs);

const ESTADOS: Record<string, { texto: string; clase: string }> = {
  disponible: { texto: 'Cupos disponibles', clase: 'ok' },
  ultimos: { texto: 'Últimos cupos', clase: 'warn' },
  completo: { texto: 'Completo', clase: 'full' },
};

const jornadas = (data.jornadas as any[])
  .map((j, i) => {
    const [y, m, d] = String(j.fecha).split('-').map(Number);
    const dt = new Date(y, (m || 1) - 1, d || 1);
    const fotos = ((j.fotos || []) as string[])
      .map((f) => resolveImageWarn(f, `flash day ${j.fecha}`))
      .filter((x): x is ImageMetadata => !!x);
    const fotosLocacion = ((j.fotosLocacion || []) as string[])
      .map((f) => resolveImageWarn(f, `flash day locación ${j.fecha}`))
      .filter((x): x is ImageMetadata => !!x);
    const ig = String(j.instagram || '').trim().replace(/^@/, '');
    const estado = ESTADOS[j.estado] ?? ESTADOS.disponible;
    return {
      ...j, i, dt, fotos, fotosLocacion, ig, estado,
      completo: j.estado === 'completo',
      dia: DIAS[dt.getDay()], num: String(d).padStart(2, '0'), mes: MESES[(m || 1) - 1],
    };
  })
  .filter((j) => j.dt >= hoy)
  .sort((a, b) => a.dt.getTime() - b.dt.getTime());

// Carrusel "Marcas que confiaron": fotos en src/assets/images/flashday/marcas/ y videos en src/assets/videos/flashday/
// (si todavía no hay nada ahí, se usan fotos del portfolio).
type Muestra = { tipo: 'foto'; img: ImageMetadata } | { tipo: 'video'; src: string };
const fotosMarcas = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/flashday/marcas/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const videosMarcas = import.meta.glob<string>('/src/assets/videos/flashday/*.{mp4,MP4,webm,WEBM,mov,MOV}', { eager: true, query: '?url', import: 'default' });
const fotosPortfolio = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/portfolio/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const soloFotos: Muestra[] = Object.values(fotosMarcas).map((m) => ({ tipo: 'foto' as const, img: m.default }));
const soloVideos: Muestra[] = Object.values(videosMarcas).map((src) => ({ tipo: 'video' as const, src }));
let muestras: Muestra[] = [];
const maxLen = Math.max(soloFotos.length, soloVideos.length * 3);
for (let k = 0, f = 0, vv = 0; k < maxLen + soloVideos.length; k++) {
  if ((k + 1) % 4 === 0 && vv < soloVideos.length) muestras.push(soloVideos[vv++]);
  else if (f < soloFotos.length) muestras.push(soloFotos[f++]);
  else if (vv < soloVideos.length) muestras.push(soloVideos[vv++]);
}
if (muestras.length === 0) {
  muestras = Object.values(fotosPortfolio).slice(0, 14).map((m) => ({ tipo: 'foto' as const, img: m.default }));
}
const duracion = Math.max(45, muestras.length * 7);
const soloVideosArr = soloVideos.map((x) => (x as any).src);
const videoEjemplo = soloVideosArr.length > 0 ? soloVideosArr[Math.floor(Math.random() * soloVideosArr.length)] : null;

const datosCliente = {
  numero,
  packs,
  extra,
  jornadas: Object.fromEntries(jornadas.map((j) => [j.i, { texto: `${j.dia} ${j.num} ${j.mes}`, modelo: j.modelo, horario: j.horario || '', packs: (j as any).packs || null }])),
};
---

<Layout
  title="Flash Day | Jornadas de fotos compartidas para marcas | CIAVA Studio"
  description="Flash Day de CIAVA Studio: una modelo, un estudio, varias marcas. Sumá tus looks a la próxima jornada en Nordelta y recibí tus fotos editadas en 5 días hábiles."
  keywords="flash day, fotos para marcas, fotografía de moda económica, jornada compartida, fotos con modelo, estudio nordelta, contenido para tienda online"
>
  <div class="fdp">
    <!-- PORTADA -->
    <section class="fdp-hero">
      <div class="fdp-hero-text">
        <p class="fdp-eyebrow">JORNADAS COMPARTIDAS PARA MARCAS</p>
        <span class="fdp-rule"></span>
        <h1 class="fdp-title">FLASH <br class="fdp-br" />DAY</h1>
        <p class="fdp-lead">
          <strong>Una modelo, un estudio, varias marcas.</strong><br />
          Sumá tus looks a la próxima jornada<br />
          y recibí tus fotos editadas en <strong class="fdp-u">5 días hábiles</strong> (igual, casi siempre te las mandamos antes 😉).
        </p>
        {desdePrecio && (
          <p class="fdp-price-row">desde <span class="fdp-price">{precio(desdePrecio)}</span> <strong class="fdp-u">por look</strong></p>
        )}
        <div class="fdp-actions">
          <a href="#fechas" class="fdp-btn">VER PRÓXIMAS FECHAS</a>
          <a href={linkPersonalizado} target="_blank" rel="noopener" class="fdp-btn fdp-btn-alt">QUIERO ALGO PERSONALIZADO</a>
        </div>
      </div>
      {portada && (
        <div class="fdp-hero-photo">
          <Image src={portada} alt="Modelo en una jornada de Flash Day de CIAVA Studio" widths={[600, 900, 1200]} sizes="(max-width: 767px) 100vw, 45vw" class="fdp-cover" loading="eager" quality={80} />
        </div>
      )}
    </section>

    <!-- CÓMO FUNCIONA -->
    <section class="fdp-section">
      <h2 class="fdp-h2">¿CÓMO FUNCIONA?</h2>
      <ol class="fdp-steps">
        <li><span>01</span><h3>Elegís tu fecha</h3><p>Mirá las próximas jornadas y la modelo de cada una.</p></li>
        <li><span>02</span><h3>Reservás tu lugar</h3><p>Nos escribís por WhatsApp y te pasamos los datos de transferencia.</p></li>
        <li><span>03</span><h3>Mandás tus productos</h3><p>En estas jornadas nos manejamos con envíos, ya que son muchas marcas en un mismo día: no podemos recibir a todo el equipo.</p></li>
        <li><span>04</span><h3>Recibís tu contenido</h3><p>Tus fotos editadas en 5 días hábiles (igual, casi siempre te las mandamos antes 😉) y el video, si elegiste Foto &amp; Video.</p></li>
      </ol>
    </section>

    <!-- MARCAS QUE CONFIARON (carrusel) -->
    {muestras.length > 0 && (
      <section class="fdp-marcas">
        <h2 class="fdp-h2">MARCAS QUE CONFIARON</h2>
        <p class="fdp-sub">Hoy tienen este material. El próximo puede ser el tuyo.</p>
        <div class="fdp-marquee">
          <div class="fdp-track" style={`--dur: ${duracion}s`}>
            {[...muestras, ...muestras].map((m, k) => (
              m.tipo === 'foto' ? (
                <Image src={m.img} alt={k < muestras.length ? 'Contenido de una marca en un Flash Day de CIAVA' : ''} widths={[300, 520]} sizes="260px" class="fdp-m-item" loading="lazy" decoding="async" quality={70} />
              ) : (
                <div class="fdp-m-video">
                  <video class="fdp-m-item" src={m.src} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
                  <span class="fdp-m-badge">REEL EDITADO</span>
                </div>
              )
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- PRÓXIMAS FECHAS -->
    <section id="fechas" class="fdp-section fdp-fechas">
      <h2 class="fdp-h2">PRÓXIMAS FECHAS</h2>
      <p class="fdp-sub">Tocá una fecha para ver a la modelo, elegir tu pack y reservar.</p>
      {jornadas.length > 0 ? (
        <div class="fdp-grid">
          {jornadas.map((j) => (
            <div class={`fdp-card ${j.completo ? 'is-full' : ''}`} data-open={j.i} role="button" tabindex="0">
              <div class="fdp-card-img">
                {j.fotos[0] ? (
                  <Image src={j.fotos[0]} alt={`Modelo del Flash Day ${j.dia} ${j.num} ${j.mes}`} widths={[400, 700]} sizes="(max-width: 767px) 100vw, 33vw" class="fdp-cover" loading="lazy" quality={75} />
                ) : (
                  <span class="fdp-card-ph">CIAVA</span>
                )}
                <div class="fdp-date"><span>{j.dia}</span><strong>{j.num}</strong><span>{j.mes}</span></div>
                {j.etiqueta ? (
          <span class="fdp-card-tag">
            {j.etiqueta}
            {j.fotosLocacion && j.fotosLocacion.length > 0 && <small class="fdp-card-tag-hint">📸 ¡Mirá más fotos de la locación!</small>}
          </span>
        ) : (
          <span class="fdp-card-tag">NORDELTA STUDIO</span>
        )}
                {j.ig && (
                  <a class="fdp-card-ig" href={`https://www.instagram.com/${j.ig}/`} target="_blank" rel="noopener" onclick="event.stopPropagation()" aria-label={`Ver Instagram de ${j.modelo}`}>
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></svg>
                    <span>@{j.ig}</span>
                  </a>
                )}
              </div>
              <div class="fdp-card-body">
                <span class={`fdp-chip ${j.estado.clase}`}>{j.estado.texto}</span>
                <h3>MODELO: {j.modelo}</h3>
            {j.tematica && <p class="fdp-card-tematica">{j.tematicaEmoji} TEMATICA {j.tematica}</p>}
                {j.horario && <p>{j.horario}</p>}
                <span class="fdp-more">{j.completo ? 'Ver jornada' : 'Ver y reservar'} →</span>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="fdp-empty">
          <p>Estamos armando las próximas fechas.</p>
          <a href={linkAvisame} target="_blank" rel="noopener" class="fdp-btn">AVISAME CUANDO HAYA FECHAS</a>
        </div>
      )}
    </section>

    <!-- PACKS -->
    <section class="fdp-section">
      <h2 class="fdp-h2">PACKS</h2>
      <p class="fdp-sub">Elegís uno de los dos y aplica a todos los looks de tu marca.</p>
      <div class="fdp-packs">
        {packs.map((p) => (
          <div class="fdp-pack-card">
            <h3>{p.nombre}</h3>
            
            {p.descripcion && <p>{p.descripcion}</p>}
          </div>
        ))}
      </div>
      <p class="fdp-packs-note">El valor exacto depende de la fecha — <a href="#fechas">entrá a la jornada que te interesa</a> para verlo.</p>
      {extra && (
        <div class="fdp-extra">
          <div>
            <p class="fdp-eyebrow">EXTRA · SE CONTRATA APARTE</p>
            <h3>{extra.nombre}</h3>
            <p>{extra.descripcion}</p>
            {videoEjemplo && (
              <span class="fdp-ver-ejemplo" tabindex="0">
                MIRÁ UN EJEMPLO ACÁ
                <span class="fdp-ejemplo-preview">
                  <video src={videoEjemplo} autoplay muted loop playsinline preload="metadata"></video>
                </span>
              </span>
            )}
          </div>
          <p class="fdp-pack-price">{precio(extra.precio)}</p>
        </div>
      )}
    </section>

    <!-- CONDICIONES -->
    <section class="fdp-section">
      <h2 class="fdp-h2">A TENER EN CUENTA</h2>
      <ul class="fdp-cond">
        <li>Cada look incluye hasta dos prendas (por ejemplo, arriba y abajo). Con accesorios es igual: un bolso es un look.</li>
        <li>Los productos se reciben hasta 24 hs antes del shooting.</li>
        <li>Incluye una ronda de ajustes básicos (luz, foco, detalles). Los cambios extra se cobran aparte.</li>
        <li>Las fotos no se pueden modificar con IA para crear otras variantes: cada producto o color cuenta como un look.</li>
        <li>Todas las aclaraciones en un solo mensaje escrito.</li>
      </ul>
    </section>

    <!-- CIERRE -->
    <section class="fdp-final">
      <h2 class="fdp-h2">¿BUSCÁS ALGO A MEDIDA?</h2>
      <p>Hacemos producciones personalizadas para tu marca, con tu modelo, tus horarios y vos en el set.</p>
      <a href={linkPersonalizado} target="_blank" rel="noopener" class="fdp-btn">QUIERO ALGO PERSONALIZADO</a>
    </section>
  </div>

  <!-- DETALLE DE CADA JORNADA -->
  <div id="fdp-modal" class="fdp-modal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="fdp-modal-bg" data-close></div>
    <div class="fdp-modal-card">
      <button type="button" class="fdp-x" aria-label="Cerrar" data-close>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      {jornadas.map((j) => (
        <div class="fdp-detail" data-j={j.i} hidden>
          <div class="fdp-gal">
            <div class="fdp-gal-main">
              {j.fotos.length > 0 ? j.fotos.map((f, k) => (
                <Image src={f} alt={`${j.modelo} — foto ${k + 1}`} widths={[400, 800]} sizes="(max-width: 767px) 90vw, 420px" class="fdp-gal-img fdp-gal-img-main" loading="lazy" quality={78} />
              )) : (
                <div class="fdp-gal-ph">Fotos de la modelo próximamente</div>
              )}
            </div>
{j.fotosLocacion && j.fotosLocacion.length > 0 && j.fotosLocacion.map((f: ImageMetadata, k: number) => (
<div class="fdp-gal-loc">
<Image src={f} alt={`Locación de la jornada ${j.dia} ${j.num} ${j.mes}`} widths={[400, 800]} sizes="(max-width: 767px) 90vw, 420px" class="fdp-gal-img" loading="lazy" quality={78} />
<span class="fdp-gal-loc-badge">¡ESTA ES LA LOCACIÓN!</span>
</div>
))}
          </div>
          <div class="fdp-info">
            <p class="fdp-eyebrow">FLASH DAY · {j.dia} {j.num} {j.mes}{j.horario ? ` · ${j.horario}` : ''}</p>
            <h3 class="fdp-model">MODELO: {j.modelo}</h3>
            {j.tematica && (
              <p class="fdp-modal-tematica">
                {j.tematicaEmoji} TEMATICA {j.tematica}
                {j.tematicaDescripcion && <span class="fdp-modal-tematica-desc"> — {j.tematicaDescripcion}</span>}
              </p>
            )}
            {j.ig && (
              <a class="fdp-ig" href={`https://www.instagram.com/${j.ig}/`} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></svg>
                @{j.ig} · ver más de su trabajo
              </a>
            )}
            <span class={`fdp-chip ${j.estado.clase}`}>{j.estado.texto}</span>

            {j.completo ? (
              <div class="fdp-full">
                <p>Esta jornada ya está completa. Escribinos y te avisamos cuando abramos la próxima.</p>
                <a href={linkAvisame} target="_blank" rel="noopener" class="fdp-btn">AVISAME PRÓXIMA FECHA</a>
              </div>
            ) : (
              <div class="fdp-form" data-form={j.i}>
                <p class="fdp-label">1. Elegí tu pack</p>
                <p class="fdp-hint fdp-hint-top">Es uno u otro: el pack que elijas aplica a todos tus looks.</p>
                {packsDe(j).map((p, k) => (
                  <label class="fdp-opt">
                    <input type="radio" name={`pack-${j.i}`} value={k} checked={k === 0} />
                    <span class="fdp-opt-txt">
                      <strong>{p.nombre}</strong>
                      <small>{p.descripcion}</small>
                      {p.tramos && <small class="fdp-tiers">+7 looks: {precio(p.tramos[1]?.precio)} c/u · +14: {precio(p.tramos[2]?.precio)} c/u</small>}
                    </span>
                    <span class="fdp-opt-price">{p.tramos ? precio(p.tramos[0].precio) : precio(p.precio)}</span>
                  </label>
                ))}
                {j.notas && j.notas.length > 0 && (
                  <ul class="fdp-notas">
                    {j.notas.map((n: string) => <li>{n}</li>)}
                  </ul>
                )}
                <p class="fdp-label">2. ¿Cuántos looks?</p>
                <div class="fdp-counter">
                  <button type="button" data-step="-1" aria-label="Menos looks">−</button>
                  <output data-looks>1</output>
                  <button type="button" data-step="1" aria-label="Más looks">+</button>
                </div>
                <p class="fdp-hint">Cada look = hasta 2 prendas o 1 accesorio.</p>
                {extra && (
                  <>
                    <p class="fdp-label">3. ¿Sumás un reel editado? <span class="fdp-opc">(opcional, aparte)</span></p>
                    <label class="fdp-opt">
                      <input type="checkbox" data-reel />
                      <span class="fdp-opt-txt"><strong>{extra.nombre}</strong><small>{extra.descripcion}</small></span>
                      <span class="fdp-opt-price">{precio(extra.precio)}</span>
                    </label>
                    {videoEjemplo && (
                      <span class="fdp-ver-ejemplo" tabindex="0">
                        MIRÁ UN EJEMPLO ACÁ
                        <span class="fdp-ejemplo-preview">
                          <video src={videoEjemplo} autoplay muted loop playsinline preload="metadata"></video>
                        </span>
                      </span>
                    )}
                  </>
                )}
                <p class="fdp-label">{extra ? '4' : '3'}. Tu marca</p>
                <input class="fdp-input" type="text" data-marca placeholder="Nombre de tu marca" autocomplete="organization" />
                <div class="fdp-total"><span>Total estimado</span><strong data-total>—</strong></div>
                <a class="fdp-btn fdp-btn-wa" data-reservar href="#" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" /></svg>
                  RESERVAR POR WHATSAPP
                </a>
                <p class="fdp-hint">Se abre WhatsApp con tu pedido armado. Te confirmamos el lugar y te pasamos los datos de transferencia.</p>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <script type="application/json" id="fdp-data" set:html={JSON.stringify(datosCliente)}></script>

  <Footer />
</Layout>

<style is:global>
  .fdp { color: #111111; padding-top: 76px; }
  @media (min-width: 768px) { .fdp { padding-top: 92px; } }
  .fdp-eyebrow { font-size: 11px; letter-spacing: .3em; margin: 0 0 10px; color: #111111; }
  .fdp-rule { display: block; width: 44px; height: 2px; background: #111111; margin-bottom: 18px; }
  .fdp-u { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 2px; font-weight: 600; color: #111111; }
