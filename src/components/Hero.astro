---
/**
 * Hero Component
 * Imagen vertical para mobile, horizontal para desktop
 */
import { Image } from 'astro:assets';
import { resolveImageWarn } from '../lib/images';
import hero from '../data/hero.json';

const heroMobile = resolveImageWarn(hero.imageMobile, 'hero — celular');
const heroDesktop = resolveImageWarn(hero.imageDesktop, 'hero — escritorio');
---

<!-- La portada queda oscura (foto + logo blanco) aunque el resto del sitio sea claro -->
<section id="hero" class="relative min-h-screen w-full overflow-hidden bg-[#0a0a0a]">
  <!-- Imagen mobile (vertical) - visible solo en mobile/tablet -->
  <div class="absolute inset-0 md:hidden">
    {heroMobile && (
      <Image
        src={heroMobile}
        alt="CIAVA Studio — Estudio de fotografía de moda en Buenos Aires"
        class="h-full w-full object-cover opacity-90"
        style="object-position: 22% center;"
        widths={[640, 960]}
        sizes="100vw"
        loading="eager"
        decoding="async"
        quality={80}
      />
    )}
  </div>

  <!-- Imagen desktop (horizontal) - visible solo en desktop -->
  <div class="absolute inset-0 hidden md:block">
    {heroDesktop && (
      <Image
        src={heroDesktop}
        alt="CIAVA Studio — Estudio de fotografía de moda en Buenos Aires"
        class="h-full w-full object-cover opacity-[0.72]"
        style="object-position: center 12%;"
        widths={[1280, 1920]}
        sizes="100vw"
        loading="eager"
        decoding="async"
        quality={80}
      />
    )}
  </div>

  <!-- Overlays (compartidos) -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a]/60 via-[#0a0a0a]/15 to-[#0a0a0a]/85"></div>
  <!-- Refuerzo de legibilidad detrás del logo -->
  <div class="absolute inset-0" style="background: radial-gradient(ellipse 60% 45% at center 48%, rgba(10,10,10,0.55) 0%, transparent 70%);"></div>
  <!-- Viñeta envolvente -->
  <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, transparent 45%, rgba(10,10,10,0.7) 100%);"></div>

  <!-- Contenido centrado -->
  <div class="relative z-10 flex min-h-screen flex-col items-center justify-center px-6 py-20">
    <!-- Pequeño acento dorado -->
    <div class="mb-6 sm:mb-8 h-8 w-px bg-gradient-to-b from-transparent via-[#ffffff]/60 to-transparent"></div>

    <!-- Logo CIAVA Studio -->
    <h1 class="hero-logo mb-6 sm:mb-8">
      <span class="sr-only">{hero.title}</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1997 820" fill="#ffffff" aria-hidden="true" class="block h-auto w-[min(72vw,560px)]">
        <path fill-rule="evenodd" d="M1272 693 1269 696 1269 708 1268 709 1268 768 1269 769 1268 807 1270 811 1277 812 1282 809 1282 697 1281 695 1277 693ZM863 693 860 696 859 763 861 782 867 795 875 804 889 812 915 814 930 811 945 798 952 786 955 763 955 722 954 721 955 699 954 697 949 696 948 698 948 762 944 787 938 795 928 804 918 807 907 808 900 807 891 803 880 793 874 783 872 772 872 696 869 693ZM1071 693 1067 698 1067 807 1068 809 1072 812 1107 812 1122 809 1135 804 1148 795 1163 774 1166 758 1166 746 1162 727 1154 716 1146 708 1124 695 1117 695 1101 692ZM1086 700 1107 700 1118 702 1121 705 1131 709 1143 720 1149 732 1150 742 1152 746 1152 755 1150 761 1149 773 1140 788 1136 792 1114 803 1090 805 1085 804 1080 798 1080 705 1082 702ZM670 694 671 699 704 700 707 701 711 705 711 808 717 812 721 811 723 808 723 706 729 700 756 700 761 699 764 696 760 693 755 692 685 692 684 693 676 692ZM1420 693 1414 696 1409 701 1404 703 1390 718 1385 729 1382 747 1382 759 1387 780 1399 797 1420 811 1438 814 1458 813 1466 811 1488 796 1501 775 1504 750 1502 732 1500 726 1490 712 1480 702 1468 694 1454 692 1450 690 1440 690 1434 692ZM1441 695 1446 695 1449 697 1461 700 1475 711 1488 730 1490 746 1488 773 1482 781 1479 789 1464 803 1457 806 1446 808 1440 808 1423 804 1408 791 1398 774 1395 754 1396 739 1398 732 1404 719 1410 711 1421 702 1425 700 1436 698ZM514 693 501 704 496 714 495 720 500 735 505 741 512 746 521 749 530 755 539 757 558 767 563 772 566 778 566 788 563 795 553 805 539 808 514 805 509 801 503 799 497 793 494 793 494 796 503 804 508 806 516 812 538 814 539 813 552 813 559 811 572 802 579 790 580 777 576 766 560 752 533 742 518 734 512 727 509 717 511 711 519 701 536 694 549 699 557 700 571 709 574 708 569 701 566 700 561 695 556 693 542 692 536 689 526 692ZM1738 10 1730 27 1727 39 1722 48 1719 59 1715 66 1714 73 1708 86 1708 89 1702 104 1701 111 1694 126 1692 137 1687 146 1685 155 1672 188 1670 198 1666 205 1664 215 1653 241 1643 274 1638 283 1636 293 1631 302 1629 