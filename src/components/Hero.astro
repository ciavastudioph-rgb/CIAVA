      </svg>
    </h1>

    <p
      id="hero-subtitle"
      class="hero-subtitle max-w-xs text-center text-[10px] font-light tracking-[0.2em] text-[#ffffff]/70 sm:max-w-md sm:text-xs sm:tracking-[0.25em] md:max-w-lg md:text-sm"
    >
      {hero.subtitle}
    </p>

    <!-- Pequeño acento dorado -->
    <div class="mt-6 sm:mt-8 h-8 w-px bg-gradient-to-b from-[#ffffff]/40 via-transparent to-transparent"></div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2 sm:bottom-12">
    <div class="flex flex-col items-center gap-2 animate-pulse-soft">
      <span class="text-[9px] font-light tracking-[0.3em] text-[#ffffff]/50 sm:text-[10px]">SCROLL</span>
      <svg class="h-4 w-4 text-[#ffffff]/40 sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero-logo {
    animation: heroLogoIn 1.6s ease-out 0.3s both;
  }
  .hero-subtitle {
    animation: heroLogoIn 1.2s ease-out 1.4s both;
  }
  @keyframes heroLogoIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-logo, .hero-subtitle { animation: none; }
  }
</style>
