  .fdp-ejemplo-preview { position: absolute; left: 0; bottom: calc(100% + 10px); width: 150px; aspect-ratio: 9 / 16; border-radius: 14px; overflow: hidden; box-shadow: 0 18px 40px rgba(0,0,0,.3); opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .18s, transform .18s; pointer-events: none; z-index: 20; background: #000000; }
