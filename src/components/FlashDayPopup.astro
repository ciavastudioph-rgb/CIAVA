---
/**
 * Pop-up de Flash Day (solo en la página principal)
 * - Aparece a los 2,5 s de entrar. Si lo cierran, no vuelve a aparecer en esa visita.
 * - La foto se toma sola de la carpeta src/assets/images/flashday/ (la primera que encuentre).
 * - Los dos botones abren WhatsApp con un mensaje ya escrito (fechas / personalizado) (número de "Contacto y datos generales").
 * - Para apagarlo: poner activo en false.
 * - Para probarlo de nuevo: abrir la web con ?flashday al final de la dirección.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import settings from '../data/settings.json';

const config = {
  activo: true,
  precio: '$50.000',
  precioDetalle: 'por look',
};

const fotos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/flashday/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);
const foto = Object.values(fotos)[0]?.default ?? null;

// Pasan mezclados: la foto principal + videos (src/assets/videos/flashday/) + fotos de marcas (src/assets/images/flashday/marcas/)
type Slide = { tipo: 'foto'; img: ImageMetadata } | { tipo: 'video'; src: string };
const videosPopup = import.meta.glob<string>('/src/assets/videos/flashday/*.{mp4,MP4,webm,WEBM,mov,MOV}', { eager: true, query: '?url', import: 'default' });
const fotosMarcasPopup = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/flashday/marcas/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const vids: Slide[] = Object.values(videosPopup).slice(0, 3).map((src) => ({ tipo: 'video' as const, src }));
const extras: Slide[] = Object.values(fotosMarcasPopup).slice(0, 3).map((m) => ({ tipo: 'foto' as const, img: m.default }));
const slides: Slide[] = foto ? [{ tipo: 'foto', img: foto }] : [];
for (let k = 0; k < Math.max(vids.length, extras.length); k++) {
  if (vids[k]) slides.push(vids[k]);
  if (extras[k]) slides.push(extras[k]);
}

const numero = (settings.contact.whatsapp || '').replace(/[^\d]/g, '');
const waLink = (msg: string) => `https://wa.me/${numero}?text=${encodeURIComponent(msg)}`;
const linkPersonalizado = waLink('¡Hola Ciava! Quiero algo personalizado para mi marca, ¿me cotizan? 😊');
---

{config.activo && (
  <div id="fd-popup" class="fd-overlay" role="dialog" aria-modal="true" aria-labelledby="fd-title" aria-hidden="true">
    <div class="fd-backdrop" data-fd-close></div>
    <div class="fd-card">
      <button type="button" class="fd-close" aria-label="Cerrar" data-fd-close>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>

      <div class="fd-text">
        <p class="fd-eyebrow">PRÓXIMAS JORNADAS ABIERTAS</p>
        <span class="fd-rule"></span>
        <h2 id="fd-title" class="fd-title">FLASH <br class="fd-br" />DAY</h2>
        <p class="fd-body">
          <strong>Una modelo, un estudio, varias marcas.</strong><br />
          Sumá tus looks a la próxima jornada<br />
          y recibí tus fotos editadas en <strong class="fd-u">72 hs</strong>.
        </p>
        <p class="fd-price-label">Contenido profesional para tu marca</p>
        <p class="fd-price-row">desde <span class="fd-price">{config.precio}</span> <strong class="fd-u fd-strong">{config.precioDetalle}</strong></p>
        <div class="fd-actions">
          <a href="/flash-day#fechas" class="fd-btn" data-fd-seen>VER PRÓXIMAS FECHAS</a>
          <a href={linkPersonalizado} target="_blank" rel="noopener" class="fd-btn fd-btn-alt" data-fd-seen>
            <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="16" fill="#25D366" /><path transform="translate(6.5 6.5) scale(0.79)" fill="#ffffff" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" /></svg>
            <span>QUIERO ALGO PERSONALIZADO</span>
          </a>
        </div>
      </div>

      {slides.length > 0 && (
        <div class="fd-photo" data-fd-slides>
          {slides.map((s, k) => (
            s.tipo === 'foto' ? (
              <Image src={s.img} alt={k === 0 ? 'Modelo en una jornada de Flash Day de Ciava Studio' : ''} widths={[480, 800]} sizes="(max-width: 767px) 92vw, 400px" class={`fd-img fd-slide ${k === 0 ? 'is-on' : ''}`} loading="lazy" decoding="async" quality={80} />
            ) : (
              <video class="fd-img fd-slide" src={s.src} muted playsinline loop preload="metadata" aria-hidden="true"></video>
            )
          ))}
        </div>
      )}
    </div>
  </div>
)}

<style is:global>
  .fd-overlay { position: fixed; inset: 0; z-index: 10000; display: flex; align-items: center; justify-content: center; padding: 16px; opacity: 0; pointer-events: none; transition: opacity .4s ease; }
  .fd-overlay.is-open { opacity: 1; pointer-events: auto; }
  .fd-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.55); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); }
  .fd-card { position: relative; display: flex; width: 100%; max-width: 880px; max-height: calc(100vh - 32px); background: #d6af88; border-radius: 26px; overflow: hidden; box-shadow: 0 30px 80px rgba(0,0,0,.35); transform: translateY(16px) scale(.98); transition: transform .45s cubic-bezier(.22,1,.36,1); }
  .fd-overlay.is-open .fd-card { transform: none; }
  .fd-text { flex: 1 1 56%; padding: 48px 44px; color: #111111; display: flex; flex-direction: column; justify-content: center; }
  .fd-photo { flex: 0 0 44%; position: relative; min-height: 500px; }
  .fd-img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 50% 20%; }
  .fd-slide { opacity: 0; transition: opacity .9s ease; }
  .fd-slide.is-on { opacity: 1; }
  .fd-close { position: absolute; top: 14px; right: 14px; z-index: 2; width: 38px; height: 38px; min-width: 38px; min-height: 38px; border-radius: 999px; background: #ffffff; color: #111111; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 10px rgba(0,0,0,.18); cursor: pointer; transition: transform .2s; }
  .fd-close:hover { transform: scale(1.06); }
  .fd-eyebrow { font-size: 11px; letter-spacing: .3em; margin: 0 0 10px; color: #111111; }
  .fd-rule { display: block; width: 44px; height: 2px; background: #111111; margin-bottom: 16px; }
  .fd-title { font-size: clamp(3rem, 8vw, 5.75rem); line-height: .92; letter-spacing: -.01em; margin: 0 0 20px; color: #111111; }
  .fd-body { font-size: 15px; line-height: 1.55; color: #2a2018; margin: 0 0 16px; }
  .fd-body strong { color: #111111; font-weight: 600; }
  .fd-strong { color: #111111; font-weight: 600; }
  .fd-u { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 2px; }
  .fd-price-label { font-size: 15px; margin: 0 0 6px; color: #2a2018; }
  .fd-price-row { font-size: 15px; color: #2a2018; margin: 0 0 26px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .fd-price { display: inline-block; background: #ffffff; color: #111111; font-weight: 700; font-size: 24px; line-height: 1.2; padding: 4px 14px; border-radius: 999px; animation: fdBounce 3.2s ease-in-out 1.5s infinite; }
  @keyframes fdBounce { 0%, 70%, 100% { transform: translateY(0); } 76% { transform: translateY(-7px); } 82% { transform: translateY(0); } 88% { transform: translateY(-3px); } 94% { transform: translateY(0); } }
  .fd-actions { display: flex; flex-direction: column; align-items: stretch; gap: 12px; width: 100%; max-width: 360px; }
  .fd-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; text-align: center; background: #111111; color: #ffffff; font-weight: 600; font-size: 12px; letter-spacing: .2em; padding: 14px 26px; border-radius: 999px; transition: transform .2s, background .2s; }
  .fd-btn:hover { background: #000000; transform: translateY(-1px); }
  .fd-btn-alt { background: transparent; color: #111111; border: 1.5px solid #111111; padding: 12.5px 24px; }
  .fd-btn-alt:hover { background: #111111; color: #ffffff; }
  .fd-btn-alt svg { width: 22px; height: 22px; flex: none; }
  @media (max-width: 767px) {
    .fd-card { flex-direction: column-reverse; max-width: 400px; overflow-y: auto; border-radius: 22px; }
    .fd-photo { flex: none; min-height: 0; height: 32vh; max-height: 250px; }
    .fd-text { padding: 18px 22px 22px; }
    .fd-title { font-size: 2.8rem; margin-bottom: 10px; }
    .fd-rule { margin-bottom: 12px; }
    .fd-body { margin-bottom: 12px; }
    .fd-btn { padding: 12px 20px; }
    .fd-btn-alt { padding: 10.5px 20px; }
    .fd-actions { max-width: none; gap: 10px; }
    .fd-br { display: none; }
    .fd-body, .fd-price-label, .fd-price-row { font-size: 13.5px; }
    .fd-price { font-size: 20px; }
    .fd-price-row { margin-bottom: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fd-price { animation: none; }
    .fd-card, .fd-overlay { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    function init() {
      var el = document.getElementById('fd-popup');
      if (!el || el.dataset.ready) return;
      el.dataset.ready = '1';
      var KEY = 'ciava-fd-popup-visto';
      var visto = false;
      try { visto = sessionStorage.getItem(KEY) === '1'; } catch (e) {}
      if (location.search.indexOf('flashday') > -1) visto = false;
      function marcar() { try { sessionStorage.setItem(KEY, '1'); } catch (e) {} }
      var slides = el.querySelectorAll('.fd-slide');
      var actual = 0, timer = null;
      function mostrar(i) {
        slides.forEach(function (s, k) {
          var on = k === i;
          s.classList.toggle('is-on', on);
          if (s.tagName === 'VIDEO') { if (on) { try { s.currentTime = 0; s.play(); } catch (e) {} } else { s.pause(); } }
        });
        actual = i;
      }
      function arrancar() { if (slides.length < 2 || timer) return; mostrar(0); timer = setInterval(function () { mostrar((actual + 1) % slides.length); }, 3500); }
      function parar() { if (timer) { clearInterval(timer); timer = null; } slides.forEach(function (s) { if (s.tagName === 'VIDEO') s.pause(); }); }
      function abrir() { el.classList.add('is-open'); el.setAttribute('aria-hidden', 'false'); arrancar(); }
      function cerrar() { el.classList.remove('is-open'); el.setAttribute('aria-hidden', 'true'); marcar(); parar(); }
      el.querySelectorAll('[data-fd-close]').forEach(function (b) { b.addEventListener('click', cerrar); });
      el.querySelectorAll('[data-fd-seen]').forEach(function (a) { a.addEventListener('click', marcar); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && el.classList.contains('is-open')) cerrar(); });
      if (!visto) setTimeout(abrir, 2500);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
